{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.cborg.lbl.gov"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Edit",
      "mcp__pystxm__get_safety_instructions",
      "mcp__pystxm__get_config",
      "mcp__pystxm__get_motor_position",
      "mcp__pystxm__plot_motor_positions",
      "mcp__pystxm__connect_to_server",
      "mcp__pystxm__update_scan",
      "mcp__pystxm__define_scan_from_file"
    ],
    "deny": [
      "Bash(sudo *)",
      "Read(/etc/**)",
      "Read(/proc/**)"
    ]
  }
}
